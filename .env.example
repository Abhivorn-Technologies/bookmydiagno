# ---- Server-only secrets (NEVER prefix these with NEXT_PUBLIC_) ----

# MongoDB Atlas connection string. Include the database name, e.g. /bookmydiagno
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/bookmydiagno?retryWrites=true&w=majority

# Long random string used to sign session cookies and demo-payment signatures.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Used ONLY by `npm run create-admin` (run from your own machine, never exposed by the app)
ADMIN_NAME=BookMyDiagno Admin
ADMIN_PHONE=9XXXXXXXXX
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars

# ---- Business rules (optional, defaults shown) ----
# Patients may cancel up to this many hours before the appointment
CANCELLATION_CUTOFF_HOURS=2
# Allow "Pay at branch" for online bookings (true/false)
PAY_AT_BRANCH_ENABLED=true
# How many days ahead patients can book
BOOKING_WINDOW_DAYS=30

# ---- Public values (safe to expose to the browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional company-wide support contact shown on the Contact page
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
